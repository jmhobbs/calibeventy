---
pagination:
  data: calibre.books
  size: 1
  alias: book
permalink: "book/{{ book.id }}/"
---
<div class="book-details">
  <img src="{{ book.coverPath }}" alt="{{ book.title }} cover" loading="lazy" class="cover" />
  <h1 data-pagefind-weight="10">{{ book.title }}</h1>
  <h3>by {% for author in book.authors %}<a href="/author/{{author.id}}#{{author.name | slugify}}" data-pagefind-filter="author">{{ author.name }}</a>{% if not forloop.last %}, {% endif %}{% endfor %}</h3>
  <p>{{ book.comments | sanitized_html }}</p>
</div>

<section>
  <h3>Metadata</h3>
  <ul>
    {% if book.publisher %}
    <li>Publisher: <a href="/publisher/{{ book.publisher.id }}#{{ book.publisher.name | slugify }}">{{ book.publisher.name }}</a></li>
    {% endif %}
    {% if book.pubdate %}
    <li>Published: {{ book.pubdate | date: "%B %d, %Y" }}</li>
    {% endif %}
    {% if book.identifiers.isbn %}
    <li data-pagefind-weight="4">ISBN: {{ book.identifiers.isbn }}</li>
    {% endif %}
    {% if book.languages %}
    <li>Language: {{ book.languages | join:", " }}</li>
    {% endif %}
    {% if book.rating %}
    <li>Rating: {{ book.rating }} / 5</li>
    {% endif %}
    {% if book.tags.length > 0 %}
    <li>Tags: {% for tag in book.tags %}<a href="/tag/{{ tag | slugify }}" data-pagefind-filter="tag">{{ tag }}</a>{% if not forloop.last %}, {% endif %}{% endfor %}</li>
    {% endif %}
  </ul>
</section>

<section>
  <h3>Formats</h3>
  <ul>
    {% for format in book.formats %}
      <li>
        {{ format.format }}
        ({{ format.sizeBytes | humanize_filesize}})
        {% if includeBookFiles %}<a href="/{{ format.path }}" download>Download</a>{% endif %}
      </li>
    {% endfor %}
  </ul>
</section>

{% if book.series %}
<section>
  <h3>Series: <span data-pagefind-filter="series">{{ book.series.name }}</span> #{{ book.series.index }}</h3>
  {% for series_book in calibre.series[book.series.id] %}
    <a href="/book/{{ series_book.id }}#{{ series_book.title | slugify }}" class="book{% if series_book.id == book.id %} active{% endif %}">
    {% if series_book.coverPath %}
      <img src="./{{ series_book.coverPath }}" alt="{{ series_book.title }} cover" loading="lazy" />
    {% else %}
      {{ series_book.title }} ({{ series_book.series.index }})
    {% endif %}</a>
  {% endfor %}
</section>
{% endif %}
