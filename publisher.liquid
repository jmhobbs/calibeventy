---
pagination:
  data: calibre.publishers
  size: 1
  alias: publisher
permalink: "publisher/{{ publisher.id }}/"
---
<h1>{{ publisher.name }}</h1>

{% for book in calibre.books %}
  {% if book.publisher.id == publisher.id %}
    <a href="/book/{{ book.id }}/#{{ book.title | slugify }}" class="book">
      {% if book.coverPath %}
        <img src="./{{ book.coverPath }}" alt="{{ book.title }} cover" loading="lazy" />
      {% else %}
        {{ book.title }}
      {% endif %}
    </a>
  {% endif %}
{% endfor %}
