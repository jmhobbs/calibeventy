---
title: Home
---

<h1>Recently Added</h1>

{% assign recent_books = calibre.books | sort: "id" | reverse %}
{% for book in recent_books limit: 24 %}
<a class="book" href="/book/{{ book.id }}/#{{ book.title | url_encode }}">
    {% if book.coverPath %}
    <img src="./{{ book.coverPath }}" alt="{{ book.title }} cover" loading="lazy" />
    {% else %}
    <span class="title">{{ book.title }}</span>
    <span class="authors">
    {% for author in book.authors %}
        <span class="author">{{ author.name }}</span>{% if not loop.last %}, {% endif %}
    {% endfor %}
    </span>
    {% endif %}
</a>
{% endfor %}

<p class="cta"><a href="/books/">View All &raquo;</a></p>

<h1>Top Tags</h1>

{% assign top_tags = calibre.tags | sort: "body.books.size" | reverse %}
<ol class="pills">
  {% for tag in top_tags limit: 24 %}
  <li><a class="tag" href="/tag/{{ tag.slug }}/">{{ tag.body.name }}</a></li>
  {% endfor %}
</ol>
